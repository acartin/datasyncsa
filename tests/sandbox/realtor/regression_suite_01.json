{
  "suite_id": "realtor_regression_suite_01",
  "suite_type": "regression",
  "generator_notes": "Regresiones reales convertidas a suite para evitar recaidas en manejo de filtros, alcance geografico y continuidad conversacional.",
  "defaults": {
    "expect": {
      "answer_excludes": [
        "seguimos viendo"
      ]
    }
  },
  "conversations": [
    {
      "id": "budget_scope_countrywide_reset",
      "description": "Abrir el alcance a todo el pais no debe arrastrar Curridabat ni provincia previa.",
      "tags": ["regression", "budget", "scope_reset", "geo"],
      "turns": [
        {
          "user": "Me gustaria ver casas en Heredia",
          "expect": {
            "require_cards": true
          }
        },
        {
          "user": "Dame detalles de la ultima",
          "expect": {
            "answer_contains_any": [
              "habitaciones",
              "baños",
              "m²"
            ]
          }
        },
        {
          "user": "Cuantos estacionamientos tiene?",
          "expect": {
            "answer_contains_any": [
              "estacionamientos",
              "vehículos",
              "vehiculos"
