            "require_cards": false
          }
        },
        {
          "user": "Y tienes algo similar en Curridabat?",
          "expect": {
            "answer_contains_any": [
              "Curridabat"
            ]
          }
        },
        {
          "user": "Ando buscando algo de menos de 200,000",
          "expect": {
            "answer_contains_any": [
              "200,000",
              "no encontr",
              "ampli"
            ],
            "expected_search_match_scope_any": [
              "none"
            ]
          }
        },
        {
          "user": "Buscame en todo el pais una casa con ese presupuesto",
          "expect": {
            "answer_contains_any": [
              "todo el país",
              "todo el pais"
            ],
            "answer_excludes": [
              "además de Curridabat",
              "ademas de curridabat"
            ],
            "manual_review_focus": [
              "debe limpiar la zona previa y abrir alcance nacional manteniendo solo el presupuesto"
            ]
          }
        },
        {
          "user": "Si, en todo el pais",
          "expect": {
            "answer_contains_any": [
              "todo el país",
              "todo el pais"
            ],
            "answer_excludes": [
              "Curridabat"
            ],
            "manual_review_focus": [
              "la confirmacion no debe reintroducir filtros geograficos viejos"
            ]
          }
        }
      ]
    },
    {
      "id": "new_search_drops_old_constraints",
      "description": "Una nueva busqueda debe soltar filtros viejos de habitaciones y estacionamientos.",
      "tags": ["regression", "new_search", "filters_reset"],
      "turns": [
        {
          "user": "Quiero una casa en Heredia con dos habitaciones y dos estacionamientos",
          "expect": {
            "answer_contains_any": [
              "Heredia",
              "habitaciones",
              "estacionamientos"
            ]
          }
        },
        {
          "user": "Ahora mejor busco un lote en Guanacaste",
          "expect": {
            "answer_contains_any": [
              "Guanacaste",
              "lote"
            ],
            "answer_excludes": [
              "dos habitaciones",
              "estacionamientos",
              "cochera"
            ]
          }
        }
      ]
    }
  ]
