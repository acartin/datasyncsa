server {
    listen 80;
    listen [::]:80;
    server_name localhost;
    client_max_body_size 100M;

    root /usr/share/nginx/html;
    index index.html index.htm;
    error_page 418 =200 /index.html;

    # Runtime frontend config (cache/version + API base) driven by env vars.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
        return 200 "const runtimeOrigin = window.location.origin;
const runtimeBaseUrlOverride = localStorage.getItem('admin_api_base_url');
const legacyPortOverride = localStorage.getItem('admin_api_port');
if (legacyPortOverride) { localStorage.removeItem('admin_api_port'); }
const resolveApiBaseUrl = () => {
  if (!runtimeBaseUrlOverride) return runtimeOrigin;
  try {
    const parsed = new URL(runtimeBaseUrlOverride, runtimeOrigin);
    // Ignore stale override like http://host (no port) when app runs on :8085.
    if (parsed.hostname === window.location.hostname && !parsed.port && window.location.port) {
      localStorage.removeItem('admin_api_base_url');
      return runtimeOrigin;
    }
    return parsed.origin;
  } catch (_) {
    localStorage.removeItem('admin_api_base_url');
    return runtimeOrigin;
  }
};
const apiBaseUrl = resolveApiBaseUrl();
const appVersion = '${APP_VERSION}';
window.AppConfig = {
  API_BASE_URL: apiBaseUrl,
  APP_VERSION: appVersion && appVersion.trim() ? appVersion.trim() : '1'
};
";
    }

    # Proxy API routes to backend (BFF)
    location ~ ^/(health|app-init|base|dashboard|system|leads|leads_v2|campaigns|ai-library|clients|countries|prompts|auth|users|roles|contacts|grid-presets|brand-config)(/|$) {
        # Only direct document navigation should fallback to SPA shell.
        # XHR/fetch for SDUI JSON must always hit backend.
        if ($http_sec_fetch_dest = "document") {
            return 418;
        }
        # Some browsers/proxies omit Sec-Fetch-* on reload; this header still indicates
        # a full document navigation and should be handled by SPA index, not backend API.
        if ($http_upgrade_insecure_requests = "1") {
            return 418;
        }

        proxy_pass http://${API_HOST}:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
