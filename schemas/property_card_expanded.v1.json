{
  "contract": "PropertyCardExpandedV1",
  "version": "1.0.0",
  "component_type": "property-card-expanded",
  "description": "Vista extendida de propiedad para detalle en modal o panel.",
  "required": [
    "type",
    "id",
    "title",
    "price",
    "currency",
    "location"
  ],
  "properties": {
    "type": {
      "const": "property-card-expanded"
    },
    "id": {
      "type": "string",
      "description": "ID interno de la propiedad."
    },
    "title": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "location": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Texto corto de la propiedad para encabezado."
    },
    "description_html": {
      "type": "string",
      "description": "Descripción rica en HTML controlado."
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "is_primary": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "map": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "open_map_url": {
          "type": "string"
        }
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "bedrooms": {
          "type": "number",
          "minimum": 0
        },
        "bathrooms": {
          "type": "number",
          "minimum": 0
        },
        "construction_sqm": {
          "type": "number",
          "minimum": 0
        },
        "lot_sqm": {
          "type": "number",
          "minimum": 0
        },
        "garage": {
          "type": "string"
        },
        "year_built": {
          "type": "string"
        }
      }
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "action_type"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "action_type": {
            "type": "string",
            "enum": [
              "open_map",
              "schedule_visit",
              "contact_advisor",
              "request_info",
              "share"
            ]
          },
          "url": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string"
        },
        "source_property_ref": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        }
      }
    }
  },
  "ui_behavior": {
    "render_mode": [
      "modal",
      "sheet",
      "full_page"
    ],
    "entry_actions": [
      "tap_property_card",
      "open_details_button"
    ],
    "close_actions": [
      "close_icon",
      "back",
      "swipe_down"
    ]
  }
}
