{
  "contract": "AgentCorePromptRuntimeV1",
  "version": "1.0.0",
  "description": "Resolucion declarativa de prompts para agent-core.",
  "sources": {
    "system_prompts": "ai_system_prompts",
    "tenant_prompts": "lead_ai_prompts",
    "scoring_prompts": "lead_scoring_prompts"
  },
  "resolution_order": [
    "ai_system_prompts(node_slug + vertical_slug)",
    "ai_system_prompts(node_slug global)",
    "lead_ai_prompts override por tenant cuando aplique"
  ],
  "agent_core_nodes": {
    "planner_route_turn": {
      "kind": "planner"
    },
    "planner_generic_turn": {
      "kind": "planner"
    },
    "planner_realtor_turn": {
      "kind": "planner"
    },
    "planner_workflow_turn": {
      "kind": "planner"
    },
    "synth_generic_answer": {
      "kind": "synthesizer"
    },
    "synth_realtor_answer": {
      "kind": "synthesizer"
    },
    "synth_clarify_answer": {
      "kind": "synthesizer"
    }
  },
  "notes": [
    "lead_scoring_prompts queda fuera de agent-core y pertenece a scoring-core",
    "Las policies del gate no deben vivir en prompts"
  ]
}
