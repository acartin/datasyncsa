{
  "contract": "AgentCoreCardRegistryV1",
  "version": "1.0.0",
  "description": "Registro declarativo de cards y mapeos por vertical.",
  "cards": {
    "property_card_expanded": {
      "schema": "schemas/property_card_expanded.v1.json",
      "source": "tool_result.listings"
    },
    "search_summary": {
      "schema": "inline/search_summary_card",
      "source": "tool_result.listings + tool_result.sql_executed"
    },
    "rag_source": {
      "schema": "inline/rag_source_card",
      "source": "tool_result.chunks"
    }
  },
  "verticals": {
    "generic": {
      "allowed_cards": [
        "rag_source"
      ]
    },
    "realtor": {
      "allowed_cards": [
        "property_card_expanded",
        "search_summary",
        "rag_source"
      ]
    }
  },
  "rules": [
    "cards_never_come_from_synthesizer",
    "renderer_is_deterministic"
  ]
}
