{
  "contract": "AgentCoreToolRegistryV1",
  "version": "1.0.0",
  "description": "Capacidades habilitadas por vertical para agent-core.",
  "tool_specs": {
    "rag": {
      "input_contract": "schemas/agent_core/contracts/tool_call.v1.json",
      "output_contract": "schemas/agent_core/contracts/tool_result.v1.json",
      "deterministic_runtime": true,
      "free_sql_allowed": false
    },
    "realtor_sql": {
      "input_contract": "schemas/agent_core/contracts/tool_call.v1.json",
      "output_contract": "schemas/agent_core/contracts/tool_result.v1.json",
      "translator": "slots_to_ast_to_sql",
      "deterministic_runtime": true,
      "free_sql_allowed": false
    },
    "workflow": {
      "input_contract": "schemas/agent_core/contracts/tool_call.v1.json",
      "output_contract": "schemas/agent_core/contracts/tool_result.v1.json",
      "deterministic_runtime": true,
      "free_sql_allowed": false
    }
  },
  "verticals": {
    "generic": {
      "enabled_tools": [
        "rag",
        "workflow"
      ]
    },
    "realtor": {
      "enabled_tools": [
        "rag",
        "realtor_sql",
        "workflow"
      ]
    }
  }
}
