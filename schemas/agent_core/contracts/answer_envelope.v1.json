{
  "contract": "AnswerEnvelopeV1",
  "version": "1.0.0",
  "description": "Respuesta final visible y persistible de agent-core.",
  "type": "object",
  "required": [
    "conversation_id",
    "text",
    "cards",
    "response_mode",
    "evidence_ids",
    "goal",
    "confidence"
  ],
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "response_mode": {
      "type": "string",
      "enum": [
        "text_only",
        "text_plus_cards"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "goal": {
      "type": "string",
      "enum": [
        "answer",
        "clarify",
        "rag",
        "realtor_search",
        "realtor_refine",
        "workflow"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
