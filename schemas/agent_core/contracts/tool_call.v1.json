{
  "contract": "ToolCallV1",
  "version": "1.1.0",
  "description": "Contrato de tool call emitido por el planner.",
  "type": "object",
  "required": [
    "tool_name"
  ],
  "properties": {
    "tool_name": {
      "type": "string",
      "enum": [
        "rag",
        "realtor_sql",
        "workflow"
      ]
    },
    "rag": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "query_text"
      ],
      "properties": {
        "query_text": {
          "type": "string"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "filter_doc_type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "realtor_slots": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "property_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "apartment",
            "house",
            "land",
            "office",
            null
          ]
        },
        "min_price": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_price": {
          "type": [
            "integer",
            "null"
          ]
        },
        "min_rooms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_rooms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "min_bathrooms": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_bathrooms": {
          "type": [
            "number",
            "null"
          ]
        },
        "min_garage": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_garage": {
          "type": [
            "integer",
            "null"
          ]
        },
        "min_area_m2": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_area_m2": {
          "type": [
            "number",
            "null"
          ]
        },
        "neighborhood": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "workflow_name"
      ],
      "properties": {
        "workflow_name": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    }
  },
  "additionalProperties": false,
  "rules": [
    "tool_name=rag_requires_rag",
    "tool_name=realtor_sql_requires_realtor_slots",
    "tool_name=workflow_requires_workflow"
  ]
}
