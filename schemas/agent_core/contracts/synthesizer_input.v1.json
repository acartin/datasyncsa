{
  "contract": "SynthesizerInputV1",
  "version": "1.0.0",
  "description": "Input visible para el synthesizer de agent-core.",
  "type": "object",
  "required": [
    "context_snapshot",
    "tool_results",
    "response_mode",
    "tenant_tone"
  ],
  "properties": {
    "context_snapshot": {
      "type": "object",
      "required": [
        "conversation_summary",
        "vertical",
        "conversation_state"
      ],
      "properties": {
        "conversation_summary": {
          "type": "string"
        },
        "vertical": {
          "type": "string",
          "enum": [
            "generic",
            "realtor"
          ]
        },
        "conversation_state": {
          "type": "object"
        },
        "last_user_turn": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tool_results": {
      "type": "array",
      "items": {
        "$ref": "tool_result.v1.json"
      }
    },
    "response_mode": {
      "type": "string",
      "enum": [
        "text_only",
        "text_plus_cards"
      ]
    },
    "tenant_tone": {
      "type": "string"
    }
  },
  "invariants": [
    "synthesizer_never_sees_router_decision",
    "synthesizer_never_decides_goal"
  ]
}
