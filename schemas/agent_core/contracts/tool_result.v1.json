{
  "contract": "ToolResultV1",
  "version": "1.0.0",
  "description": "Salida normalizada de una tool del runtime.",
  "type": "object",
  "required": [
    "tool_name",
    "status"
  ],
  "properties": {
    "tool_name": {
      "type": "string",
      "enum": [
        "rag",
        "realtor_sql",
        "workflow"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "chunk_id",
              "doc_id",
              "content"
            ],
            "properties": {
              "chunk_id": {
                "type": "string"
              },
              "doc_id": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "listings": {
          "type": "array",
          "items": {
            "$ref": "../../canonical_property.json"
          }
        },
        "sql_executed": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_output": {
          "type": "object"
        }
      }
    }
  }
}
