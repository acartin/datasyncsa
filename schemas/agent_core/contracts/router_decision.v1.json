{
  "contract": "RouterDecisionV1",
  "version": "1.1.0",
  "description": "Salida cerrada del planner de agent-core.",
  "type": "object",
  "required": [
    "goal",
    "confidence",
    "tool_calls",
    "missing_slots",
    "response_mode"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "enum": [
        "answer",
        "clarify",
        "rag",
        "realtor_search",
        "realtor_refine",
        "workflow"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "$ref": "tool_call.v1.json"
      }
    },
    "missing_slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clarify_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "response_mode": {
      "type": "string",
      "enum": [
        "text_only",
        "text_plus_cards"
      ]
    }
  },
  "invariants": [
    "planner_only_decides",
    "planner_never_sees_tool_results",
    "goal=clarify_has_no_tool_calls",
    "planner_never_emits_free_sql"
  ]
}
