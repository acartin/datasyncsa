{
  "version": "1.0",
  "contract": "canonical_property",
  "description": "Contrato canónico de propiedad para ETL, búsqueda y render SDUI.",
  "fields": {
    "property_id_internal": "string",
    "client_id": "string",
    "title": "string",
    "description_html": "string",
    "price": "number",
    "currency": "string",
    "address": "string",
    "features": {
      "garage": "string",
      "garage_clean": "integer",
      "bedrooms": "string",
      "bedrooms_clean": "integer",
      "bathrooms": "string|number",
      "bathrooms_clean": "number",
      "sqm_clean": "integer",
      "lot_size_sqm": "string",
      "year_built": "string",
      "amenities": [
        "string"
      ],
      "is_featured": "boolean",
      "size_unit": "string",
      "address": "string"
    },
    "media": {
      "primary_image_url": "string",
      "image_urls": [
        "string"
      ]
    },
    "location": {
      "country": "string",
      "province": "string",
      "lat": "number",
      "lng": "number"
    },
    "meta": {
      "source_system": "string",
      "source_property_ref": "string",
      "ingested_at": "iso8601",
      "updated_at": "iso8601"
    }
  },
  "required": [
    "property_id_internal",
    "client_id",
    "title",
    "description_html",
    "price",
    "currency",
    "features.bedrooms_clean",
    "features.bathrooms_clean",
    "features.garage_clean"
