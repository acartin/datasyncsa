  "normalization_rules": {
    "bedrooms_clean": "extraer entero desde bedrooms cuando venga texto",
    "bathrooms_clean": "extraer decimal desde bathrooms cuando venga texto",
    "garage_clean": "extraer entero desde garage cuando venga texto",
    "price": "debe ser > 0",
    "amenities": "array de strings sin nulos",
    "description_html": "HTML permitido y sanitizado"
  }
}
