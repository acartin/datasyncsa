{
  "contract": "ScoreConversationRequestV1",
  "version": "1.0.0",
  "description": "Payload minimo que agent-core o routing-core entregan a scoring-core.",
  "type": "object",
  "required": [
    "client_id",
    "lead_id",
    "conversation_id"
  ],
  "properties": {
    "client_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "channel": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "notes": [
    "agent-core no envia model_id ni prompt_id",
    "scoring-core resuelve scoring desde su propio dominio"
  ]
}
